# ---------------------------------------------------------------- KisanSetu configuration
# Copy to .env and run:  python scripts/generate_keys.py   (fills the secrets below)
APP_NAME=KisanSetu
# production → requires all secrets + Redis, disables /api/docs
ENV=development
# auto-approve farms/GSTIN/insurance; SMS/WhatsApp/email simulated (see Admin → Outbox)
TEST_MODE=true
BASE_URL=http://localhost:8088
PORT=8088
# e.g. kisansetu.example.in,www.kisansetu.example.in
ALLOWED_HOSTS=*
FORCE_HTTPS=false
# IPs of your reverse proxy (for correct client IPs)
TRUSTED_PROXIES=127.0.0.1

# ---------------------------------------------------------------- secrets (generate_keys.py)
SECRET_KEY=
PASSWORD_PEPPER=
# "k1:<base64 32 bytes>" — prepend a new key to rotate: "k2:...,k1:..."
FIELD_ENCRYPTION_KEYS=
BLIND_INDEX_KEY=

# ---------------------------------------------------------------- data stores
# Use 127.0.0.1, not "localhost": on Windows "localhost" tries IPv6 ::1 first and each new connection then waits ~2 s.
DATABASE_URL=postgresql+asyncpg://kisan:kisan@127.0.0.1:5444/kisansetu
# dev only; production uses: alembic upgrade head
AUTO_CREATE_TABLES=true
REDIS_URL=redis://:kisan-redis@127.0.0.1:6384/0
SOCKETIO_REDIS=true

# ---------------------------------------------------------------- AI providers (tried in this order)
# OpenAI-compatible endpoint serving Gemma, e.g. http://localhost:8000/v1 (empty = skip this provider)
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=gemma
# e.g. http://localhost:8001/v1
VLLM_BASE_URL=
VLLM_MODEL=google/gemma-3-4b-it
# failsafe Gemma 3: http://localhost:11434/v1 (Ollama) or https://generativelanguage.googleapis.com/v1beta/openai/
GEMMA3_BASE_URL=
GEMMA3_API_KEY=ollama
GEMMA3_MODEL=gemma3:4b
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_CONCURRENCY=4
# leave empty to use built-in multilingual hashing embeddings
AI_EMBEDDINGS_MODEL=

# ---------------------------------------------------------------- OCR
# e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
OCR_ENGINES=tesseract,rapidocr

# ---------------------------------------------------------------- GSTIN API (ignored in TEST_MODE)
# e.g. https://sheet.gstincheck.co.in/check/{key}/{gstin}
GSTIN_API_URL=
GSTIN_API_KEY=

# ---------------------------------------------------------------- messaging (ignored in TEST_MODE)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=KisanSetu <no-reply@example.com>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# ---------------------------------------------------------------- external job hunt (Google Programmable Search)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# ---------------------------------------------------------------- optional antivirus for uploads (clamd)
CLAMAV_HOST=
CLAMAV_PORT=3310

# ---------------------------------------------------------------- first superadmin (created on startup if missing)
SUPERADMIN_PHONE=
SUPERADMIN_EMAIL=
# ≥10 chars, letters + digits
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Super Admin

# ---------------------------------------------------------------- scaling
# worker processes; >1 needs Redis (shared sessions/limits/bans/sockets) — browsers then use WebSocket only
WEB_CONCURRENCY=1
# per worker (+ same overflow); keep workers x 2 x pool below Postgres max_connections
DB_POOL_SIZE=10
# refuse uploads that cannot be scanned
CLAMAV_REQUIRED=true
